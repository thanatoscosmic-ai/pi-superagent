{
	"root": true,
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"vcs": { "enabled": false },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none",
			"correctness": { "noUnusedVariables": "error", "noUnreachable": "error" },
			"suspicious": { "noDebugger": "error", "noDuplicateObjectKeys": "error" }
		}
	}
}
